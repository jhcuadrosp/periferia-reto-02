AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_TOKENS=60000
AGENT_PROVIDER_TIMEOUT_MS=15000

# API HTTP local. Para probar sin consumir Gemini: AGENT_PROVIDER=mock.
PORT=3000
HOST=127.0.0.1
# Vacío: origen local calculado al iniciar. HTTPS habilita la cookie Secure.
PUBLIC_ORIGIN=
